{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"internship-frontend",
				"start"
			],
			"isBackground": true
		},
		{
			"label": "Start frontend (cmd)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"npm",
				"--prefix",
				"internship-frontend",
				"start"
			],
			"isBackground": true
		},
		{
			"label": "Start frontend (npm.cmd)",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"internship-frontend",
				"start"
			],
			"isBackground": true
		},
		{
			"label": "Start frontend (npm.cmd on 3000)",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"internship-frontend",
				"start"
			],
			"isBackground": true
		},
		{
			"label": "Start backend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true
		}
	]
}