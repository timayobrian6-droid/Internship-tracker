{
  "name": "Internship Tracker",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm ci && npm --prefix internship-frontend ci",
  "postStartCommand": "npm run dev & npm --prefix internship-frontend start",
  "forwardPorts": [3000, 5000],
  "portsAttributes": {
    "3000": {
      "label": "Frontend",
      "onAutoForward": "openPreview"
    },
    "5000": {
      "label": "Backend API",
      "onAutoForward": "silent"
    }
  }
}
