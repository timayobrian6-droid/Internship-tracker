{
  "name": "Internship Tracker",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",

  // 1) Install ALL deps (backend + frontend) on container creation
  "postCreateCommand": "npm install && npm --prefix internship-frontend install",

  // 2) Start backend + frontend automatically every time the Codespace opens
  "postStartCommand": "bash .devcontainer/start-services.sh",

  "forwardPorts": [3000, 5000],
  "portsAttributes": {
    "3000": {
      "label": "Frontend",
      "onAutoForward": "openBrowser"
    },
    "5000": {
      "label": "Backend API",
      "onAutoForward": "silent"
    }
  },

  // Environment variables for backend + frontend
  "containerEnv": {
    "PORT": "5000",
    "BROWSER": "none",
    "CI": "true"
  }
}
